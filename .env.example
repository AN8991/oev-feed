# ================== OEV Feed Example Environment ==================
# Copy this file to .env and fill in your actual secrets and endpoints.

# --- Provider API Keys ---
ALCHEMY_API_KEY="your-alchemy-api-key"
INFURA_API_KEY="your-infura-api-key"
BLOCKDAEMON_API_KEY="your-blockdaemon-api-key"
BLOCKCYPHER_API_KEY="your-blockcypher-api-key"
QUICKNODE_API_KEY="your-quicknode-api-key"
ETHERSCAN_API_KEY="your-etherscan-api-key"
ANKR_API_KEY="your-ankr-api-key"
POCKET_API_KEY="your-pocket-api-key"
CONDUIT_API_KEY="your-conduit-api-key"
GRAPH_STUDIO_API_KEY="your-graph-studio-api-key"

# --- Database ---
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/oev_feed"
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin123
DB_NAME=oev_feed

# --- Logging ---
LOG_LEVEL="info"

# --- App URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Mainnet Node Endpoints ---
ETHEREUM_WS_URL="wss://mainnet.infura.io/ws/v3/${INFURA_API_KEY}"
ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/${INFURA_API_KEY}"
BLAST_WS_URL="wss://blast-mainnet.infura.io/ws/v3/${INFURA_API_KEY}"
BLAST_RPC_URL="https://blast-mainnet.infura.io/v3/${INFURA_API_KEY}"
ARB_WS_URL="wss://arbitrum-mainnet.infura.io/ws/v3/${INFURA_API_KEY}"
ARB_RPC_URL="https://arbitrum-mainnet.infura.io/v3/${INFURA_API_KEY}"
MANTLE_WS_URL="wss://mantle-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
MANTLE_RPC_URL="https://mantle-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
MODE_RPC_WS_URL="wss://rpc-mode-mainnet-0.t.conduit.xyz/${CONDUIT_API_KEY}"
MODE_RPC_URL="https://rpc-mode-mainnet-0.t.conduit.xyz/${CONDUIT_API_KEY}"

# --- Testnet Node Endpoints ---
ETHEREUM_TESTNET_WS_URL="wss://sepolia.infura.io/ws/v3/${INFURA_API_KEY}"
ETHEREUM_TESTNET_RPC_URL="https://sepolia.infura.io/v3/${INFURA_API_KEY}"
BLAST_TESTNET_WS_URL="wss://blast-sepolia.infura.io/ws/v3/${INFURA_API_KEY}"
BLAST_TESTNET_RPC_URL="https://blast-sepolia.infura.io/v3/${INFURA_API_KEY}"
ARB_TESTNET_WS_URL="wss://arbitrum-sepolia.infura.io/ws/v3/${INFURA_API_KEY}"
ARB_TESTNET_RPC_URL="https://arbitrum-sepolia.infura.io/v3/${INFURA_API_KEY}"
MANTLE_TESTNET_WS_URL="wss://mantle-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
MANTLE_TESTNET_RPC_URL="https://mantle-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}"
MODE_TESTNET_WS_URL="wss://rpc-mode-sepolia-xxxxxxx.t.conduit.xyz/${CONDUIT_API_KEY}"
MODE_TESTNET_RPC_URL="https://rpc-mode-sepolia-xxxxxxx.t.conduit.xyz/${CONDUIT_API_KEY}"

# --- HTTP Configuration ---
HTTP_TIMEOUT=30000
HTTP_MAX_REDIRECTS=5
HTTP_RETRIES=3
HTTP_RETRY_DELAY=1000
HTTP_MAX_CONTENT_LENGTH=10485760

# --- HTTP Rate Limiting ---
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_REQUESTS=100
HTTP_RATE_LIMIT_WINDOW=60000

# --- HTTP Circuit Breaker ---
HTTP_CIRCUIT_BREAKER_ENABLED=true
HTTP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HTTP_CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# --- Etherscan API Configuration ---
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
ETHERSCAN_TIMEOUT=15000
ETHERSCAN_RATE_LIMIT_REQUESTS=5
ETHERSCAN_RATE_LIMIT_WINDOW=1000

# --- Alchemy API Configuration ---
ALCHEMY_TIMEOUT=10000
ALCHEMY_RATE_LIMIT_REQUESTS=300
ALCHEMY_RATE_LIMIT_WINDOW=1000

# --- Infura API Configuration ---
INFURA_TIMEOUT=10000
INFURA_RATE_LIMIT_REQUESTS=100
INFURA_RATE_LIMIT_WINDOW=1000

# --- Aave V2 Ethereum Contract Addresses ---
AAVE_V2_ETHEREUM_POOL="0x7d2768dE32b0b80b7a3454c06BdAc94A69DDc7A9"
AAVE_V2_ETHEREUM_DATA_PROVIDER="0x057835Ad21a177dbdd3090bB1CAE03EaCF78Fc6d"
AAVE_V2_ETHEREUM_ORACLE="0xA50ba011c48153De246E5192C8f9258A2ba79Ca9"

# --- Aave V3 Ethereum Contract Addresses ---
AAVE_V3_ETHEREUM_POOL="0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2"
AAVE_V3_ETHEREUM_DATA_PROVIDER="0x7B4EB56E7CD4b454BA8ff71E4518426369a138a3"
AAVE_V3_ETHEREUM_ORACLE="0x54586bE62E3c3580375aE3723C145253060Ca0C2"

# --- Optional: Override default provider (defaults to ALCHEMY) ---
# ACTIVE_PROVIDER=INFURA
# FALLBACK_PROVIDER=ALCHEMY