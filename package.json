{
  "name": "oev-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "verify:contracts": "ts-node -r tsconfig-paths/register scripts/verify-contracts.ts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest test/unit",
    "test:integration": "ts-node -r tsconfig-paths/register scripts/test-integration.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:aave": "ts-node -r tsconfig-paths/register scripts/aave/test-aave-v3-adapter.ts",
    "test:address-validation": "ts-node -r tsconfig-paths/register scripts/integration/test-address-validation.ts",
    "test:data-format": "ts-node -r tsconfig-paths/register scripts/integration/test-data-format.ts",
    "test:provider-monitoring": "ts-node -r tsconfig-paths/register scripts/infrastructure/test-provider-monitoring.ts",
    "test:database": "ts-node -r tsconfig-paths/register scripts/database/test-database-connection.ts",
    "test:risk-assessment": "ts-node -r tsconfig-paths/register scripts/test-risk-assessment.ts",
    "test:risk-simple": "ts-node -r tsconfig-paths/register scripts/test-risk-simple.ts",
    "test:risk-scenarios": "ts-node -r tsconfig-paths/register scripts/test-risk-scenarios.ts",
    "test:risk-mock": "ts-node -r tsconfig-paths/register scripts/test-risk-mock.ts",
    "test:risk-isolated": "ts-node -r tsconfig-paths/register scripts/test-risk-isolated.ts",
    "test:risk-e2e": "ts-node -r tsconfig-paths/register scripts/test-risk-e2e.ts",
    "test:risk-db": "ts-node -r tsconfig-paths/register scripts/test-risk-db-only.ts",
    "db:add-indexes": "ts-node -r tsconfig-paths/register scripts/database/add-performance-indexes.ts",
    "db:check-positions": "ts-node -r tsconfig-paths/register scripts/database/check-position-ids.ts",
    "discovery:aave-v2": "ts-node -r tsconfig-paths/register scripts/discovery/aave-v2-user-discovery.ts",
    "discovery:aave-v3": "ts-node -r tsconfig-paths/register scripts/discovery/aave-v3-user-discovery.ts",
    "build": "tsc",
    "start": "ts-node -r tsconfig-paths/register src/main.ts"
  },
  "dependencies": {
    "@aave/core-v3": "^1.18.0",
    "@bgd-labs/aave-address-book": "^2.31.0",
    "@makerdao/multicall": "^0.12.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.2",
    "@types/express": "^5.0.1",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "nestjs-pino": "^4.4.0",
    "opossum": "^9.0.0",
    "path-to-regexp": "6.2.1",
    "pg": "^8.14.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.22",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.17.17",
    "@types/node-fetch": "^2.6.13",
    "@types/opossum": "^8.1.9",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "axios": "^1.7.9",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
