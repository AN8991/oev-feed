{
  "name": "oev-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "verify:contracts": "ts-node -r tsconfig-paths/register scripts/verify-contracts.ts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest test/unit",
    "test:integration": "npm run test:aave && npm run test:database",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:aave": "ts-node -r tsconfig-paths/register scripts/test-aave-fetch.ts",
    "test:address-validation": "ts-node -r tsconfig-paths/register scripts/test-address-validation.ts",
    "test:data-format": "ts-node -r tsconfig-paths/register scripts/test-data-format.ts",
    "test:provider-monitoring": "ts-node -r tsconfig-paths/register scripts/test-provider-monitoring.ts",
    "build": "tsc",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@aave/core-v3": "^1.18.0",
    "@bgd-labs/aave-address-book": "^2.31.0",
    "@nestjs/common": "^11.0.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.20",
    "@nestjs/platform-express": "^11.0.20",
    "@nestjs/swagger": "^11.1.4",
    "@nestjs/typeorm": "^11.0.0",
    "@types/express": "^5.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.9.0",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.22",
    "winston": "^3.11.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.17.17",
    "@types/pg": "^8.10.9",
    "axios": "^1.7.9",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
